      "css": ".ds-label{display:flex;flex-direction:column;gap:7px;color:var(--ink,#f3f4fc);font:500 .875rem -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-input{min-height:44px;padding:10px 12px;border:1px solid var(--line,#353d5b);border-radius:8px;background:var(--paper,#0f1220);color:var(--ink,#f3f4fc);font:inherit;caret-color:var(--secondary,#b9a3ff);transition:border-color 160ms cubic-bezier(0.22, 1, 0.36, 1)}.ds-input::placeholder{color:var(--muted,#a7afc9)}.ds-input:hover{border-color:var(--muted,#a7afc9)}.ds-input:focus-visible{outline:2px solid var(--secondary,#b9a3ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Current route remains explicit through aria-current and tonal selection.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#library\" aria-current=\"page\">My library</a><a href=\"#discover\">Discover</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;font:400 .875rem -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-nav a{display:flex;align-items:center;min-height:46px;padding:12px 14px;border-radius:8px;color:var(--muted,#a7afc9);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{background:var(--raised,#242a42);color:var(--secondary,#b9a3ff)}.ds-nav a:focus-visible{outline:2px solid var(--secondary,#b9a3ff);outline-offset:4px}"
    },
    {
      "name": "Genre tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Supporting genre destination with a restrained raised fill.",
      "html": "<a class=\"ds-tag\" href=\"#genre\">Adventure</a>",
      "css": ".ds-tag{display:inline-flex;align-items:center;min-height:30px;padding:3px 10px;border-radius:6px;background:var(--raised,#242a42);color:var(--secondary,#b9a3ff);font:400 .75rem -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;text-decoration:none}.ds-tag:hover{text-decoration:underline;text-underline-offset:4px}.ds-tag:focus-visible{outline:2px solid var(--secondary,#b9a3ff);outline-offset:4px}"
    },
    {
      "name": "Poster card",
      "kind": "card",
      "refersTo": "poster",
      "description": "Structural preview; unavailable artwork is labeled and list management remains separate.",
      "html": "<article class=\"ds-card\"><a class=\"ds-poster\" href=\"#anime\"><div class=\"ds-cover\">Artwork unavailable</div><h3>Anime title</h3></a><p>Year unknown</p><a class=\"ds-manage\" href=\"#list\">Manage list</a></article>",
      "css": ".ds-card{width:180px;font:400 .75rem/1.6 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--muted,#a7afc9)}.ds-poster{display:block;color:var(--ink,#f3f4fc);text-decoration:none;border-radius:14px}.ds-cover{aspect-ratio:2/3;display:flex;align-items:center;justify-content:center;border:1px solid var(--line,#353d5b);border-radius:14px;overflow:hidden;background:var(--surface,#191d30);transition:transform 160ms cubic-bezier(0.22, 1, 0.36, 1),border-color 160ms cubic-bezier(0.22, 1, 0.36, 1),box-shadow 160ms cubic-bezier(0.22, 1, 0.36, 1)}.ds-poster h3{margin:12px 0 4px;font-size:.875rem;line-height:1.45;font-weight:600}.ds-card p{margin:0 0 8px}.ds-manage{display:inline-flex;align-items:center;min-height:36px;color:var(--secondary,#b9a3ff);font-size:.8125rem;text-decoration:none}.ds-manage:hover{text-decoration:underline}.ds-poster:focus-visible{outline:2px solid var(--secondary,#b9a3ff);outline-offset:4px}.ds-manage:focus-visible{outline:2px solid var(--secondary,#b9a3ff);outline-offset:4px}@media(hover:hover) and (pointer:fine){.ds-poster:hover .ds-cover,.ds-poster:focus-visible .ds-cover{transform:translateY(-3px);border-color:var(--muted,#a7afc9);box-shadow:0 8px 18px #0004}.ds-poster:hover h3{color:var(--secondary,#b9a3ff)}}@media(prefers-reduced-motion:reduce){.ds-cover{transition:none}.ds-poster:hover .ds-cover,.ds-poster:focus-visible .ds-cover{transform:none}}"
    }
  ],
  "narrative": {
    "northStar": "The late-night anime journal",
    "overview": "Midnight Sakura is atmospheric, crisp and restrained. Opaque midnight and indigo surfaces support readable product text; real anime artwork supplies the strongest color and visual interest. The same foundations serve public discovery, authentication, private library operations and supporting routes.\n\nThis replaces the retired Prism world. The eye/aperture mark and lowercase wordmark remain; optical glass, oversized display lettering and pointer-driven scenery do not belong to the current identity.",
    "keyCharacteristics": [
      "Artwork-led browsing with persistent titles and direct list paths.",
      "Compact navigation, visible search and aligned, responsive content.",
      "Opaque surfaces, quiet static ambience and accessible state feedback."
    ],
    "rules": [
      {
        "name": "The Text Before Color Rule",
        "body": "Status, source availability and errors must remain understandable without their color.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use shared foundations and real artwork across every route.",
      "Do preserve visible titles, search, focus and season-specific list paths on touch and keyboard.",
      "Do keep the shared sidebar grid and readable light/system/custom palettes intact.",
      "Do preserve source attribution, cached-art provenance, measured derivatives and explicit unavailable labels.",
      "Do preserve authentication/session refresh, verified season grouping, selected-season editor keys and original anime IDs for progress, scores, notes and collection membership."
    ],
    "donts": [
      "Don't restore Prism glass, shaders, canvas scenery, refracting lenses, visual pointer loops, tilt, parallax, ripple or animated backgrounds.",
      "Don't introduce oversized marketing panels, fabricated ratings, statistics or activity.",
      "Don't apply Syne to ordinary UI text or restore Unbounded and Space Mono.",
      "Don't hide essential actions behind hover or communicate status through color alone.",
      "Don't discard real smaller source art, enlarge cached originals or treat fallback Sakuga artwork as the anime's poster."
    ]
  }
}
